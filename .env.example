# 复制成 .env 后填写。.env 已被 .gitignore 忽略，不要提交。
# docker compose 会从这个文件读变量，同时注入 exporter 容器（用于 config.yaml 里的 ${XIAOMI_*}）。

# ---- 设备（transport: local 时必填）----
# 用 make token 扫码登录后，脚本会自动把 token 和 IP 写到这里
XIAOMI_IP=192.168.1.50
XIAOMI_TOKEN=00000000000000000000000000000000
# 接第二台设备就再加一组，并在 exporter/config.yaml 的 devices 里引用
# XIAOMI_PLUG_IP=192.168.1.51
# XIAOMI_PLUG_TOKEN=00000000000000000000000000000000

# ---- 镜像 ----
# 留空 = 用本地构建的镜像。想直接用已发布的镜像就打开下面这行，
# 然后 docker compose pull && docker compose up -d --no-build
# MIJIA_IMAGE=effectwei/mijia-exporter:1.0.2

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ---- 端口（宿主机侧）----
# 如果 3000/9090 已被别的服务占用（很常见），改这里即可，容器内部端口不用动。
# 例如：GRAFANA_PORT=33000
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
# EXPORTER_PORT=9101
# 容器以宿主 uid 运行（原因见 docker-compose.yml 的 user:），下面两项由 make init 自动写入
# EXPORTER_UID=1000
# EXPORTER_GID=1000
